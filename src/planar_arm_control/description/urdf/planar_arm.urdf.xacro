<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="planar_arm">

  <xacro:arg name="controller_config" default=""/>

  <!-- Materials -->
  <material name="base_color">
    <color rgba="0.2 0.2 0.25 1"/>
  </material>

  <material name="link1_color">
    <color rgba="0.1 0.4 0.9 1"/>
  </material>

  <material name="link2_color">
    <color rgba="0.1 0.8 0.4 1"/>
  </material>

  <material name="link3_color">
    <color rgba="0.9 0.4 0.1 1"/>
  </material>

  <material name="tool_color">
    <color rgba="1 0.1 0.1 1"/>
  </material>

  <!-- World link -->
  <link name="world"/>

  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="2.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0"
               iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.1"/>
      <geometry>
        <cylinder radius="0.25" length="0.2"/>
      </geometry>
      <material name="base_color"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.1"/>
      <geometry>
        <cylinder radius="0.25" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- Fix base to world -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- Link 1 -->
  <link name="link1">
    <inertial>
      <origin xyz="1.5 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="1.51" iyz="0" izz="1.51"/>
    </inertial>

    <visual>
      <origin xyz="1.5 0 0"/>
      <geometry>
        <box size="3.0 0.15 0.15"/>
      </geometry>
      <material name="link1_color"/>
    </visual>

    <collision>
      <origin xyz="1.5 0 0"/>
      <geometry>
        <box size="3.0 0.15 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="3.14159265"
           effort="200" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <inertial>
      <origin xyz="1.0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.003" ixy="0" ixz="0"
               iyy="0.44" iyz="0" izz="0.44"/>
    </inertial>

    <visual>
      <origin xyz="1.0 0 0"/>
      <geometry>
        <box size="2.0 0.13 0.13"/>
      </geometry>
      <material name="link2_color"/>
    </visual>

    <collision>
      <origin xyz="1.0 0 0"/>
      <geometry>
        <box size="2.0 0.13 0.13"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="3.0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0943951" upper="2.0943951"
           effort="100" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <inertial>
      <origin xyz="0.75 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.19" iyz="0" izz="0.19"/>
    </inertial>

    <visual>
      <origin xyz="0.75 0 0"/>
      <geometry>
        <box size="1.5 0.11 0.11"/>
      </geometry>
      <material name="link3_color"/>
    </visual>

    <collision>
      <origin xyz="0.75 0 0"/>
      <geometry>
        <box size="1.5 0.11 0.11"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="2.0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0943951" upper="2.0943951"
           effort="50" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- End effector -->
  <link name="tool_link">
    <inertial>
      <origin xyz="-0.25 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>

    <visual>
      <origin xyz="-0.25 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
      <material name="tool_color"/>
    </visual>

    <collision>
      <origin xyz="-0.25 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="tool_fixed_joint" type="fixed">
    <parent link="link3"/>
    <child link="tool_link"/>
    <origin xyz="1.5 0 0"/>
  </joint>

  <!-- Parallel-jaw gripper: both fingers move outward when opened. -->
  <link name="left_finger">
    <inertial>
      <origin xyz="0.20 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00089" ixy="0" ixz="0"
               iyy="0.00285" iyz="0" izz="0.00205"/>
    </inertial>
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry><box size="0.40 0.06 0.26"/></geometry>
      <material name="tool_color"/>
    </visual>
    <collision>
      <origin xyz="0.20 0 0"/>
      <geometry><box size="0.40 0.06 0.26"/></geometry>
    </collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="left_finger"/>
    <origin xyz="-0.13 -0.17 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.05" upper="0.16" effort="20" velocity="0.2"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_finger">
    <inertial>
      <origin xyz="0.20 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00089" ixy="0" ixz="0"
               iyy="0.00285" iyz="0" izz="0.00205"/>
    </inertial>
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry><box size="0.40 0.06 0.26"/></geometry>
      <material name="tool_color"/>
    </visual>
    <collision>
      <origin xyz="0.20 0 0"/>
      <geometry><box size="0.40 0.06 0.26"/></geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="right_finger"/>
    <origin xyz="-0.13 0.17 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="0.16" effort="20" velocity="0.2"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <gazebo reference="left_finger">
    <mu1>3.0</mu1>
    <mu2>3.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="right_finger">
    <mu1>3.0</mu1>
    <mu2>3.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ROS 2 Control -->
  <ros2_control name="PlanarArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.308996939</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.727875960</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ROS 2 Control Plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
      <hold_joints>true</hold_joints>
    </plugin>
  </gazebo>

</robot>